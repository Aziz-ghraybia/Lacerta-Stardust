<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0d1f"
    android:padding="28dp">

    <!-- App name -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LACERTA STARDUST"
        android:textColor="#6a8fff"
        android:textSize="11sp"
        android:letterSpacing="0.25"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp" />

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AWAITING ALIGNMENT"
        android:textColor="#3a4a6a"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Connected device name -->
    <TextView
        android:id="@+id/tvDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#e8f0ff"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Hint text -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#3a4a6a"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="40dp" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bluetooth warning -->
    <LinearLayout
        android:id="@+id/layoutBluetoothWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#5c1010"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_disconnect"
            android:layout_marginEnd="12dp"
            android:tint="#e05252" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bluetooth is off"
            android:textColor="#e8f0ff"
            android:textSize="14sp" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#e8f0ff"
            android:textSize="12sp"
            android:backgroundTint="#7a1a1a"
            android:onClick="openBluetoothSettings"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

    </LinearLayout>

    <!-- Accessibility warning -->
    <LinearLayout
        android:id="@+id/layoutAccessibilityWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1e1800"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notification"
            android:layout_marginEnd="12dp"
            android:tint="#f0b429" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Accessibility permission required"
            android:textColor="#e8f0ff"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEnableAccessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable"
            android:textColor="#0a0d1f"
            android:textSize="12sp"
            android:backgroundTint="#f0b429"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

    </LinearLayout>

</LinearLayout>
