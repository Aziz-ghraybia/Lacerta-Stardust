<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0a0d1f">

    <!-- Stars header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦  ★  ✦"
        android:textSize="14sp"
        android:textColor="#f0b429"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp" />

    <!-- App title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LACERTA STARDUST"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#e8f0ff"
        android:letterSpacing="0.2"
        android:layout_marginBottom="40dp" />

    <!-- Connection status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦  AWAITING ALIGNMENT"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#3a4a6a"
        android:letterSpacing="0.15"
        android:layout_marginBottom="8dp" />

    <!-- Connected device name -->
    <TextView
        android:id="@+id/tvDeviceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#6a8fff"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Hint text -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#3a4a6a"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="40dp" />

    <!-- Bluetooth warning -->
    <LinearLayout
        android:id="@+id/layoutBluetoothWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0d0a1a"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡  Bluetooth is off — turn it on to connect"
            android:textColor="#e05252"
            android:textSize="13sp" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:backgroundTint="#00000000"
            android:textColor="#e05252"
            android:textSize="11sp"
            android:onClick="openBluetoothSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>

    <!-- Accessibility warning -->
    <LinearLayout
        android:id="@+id/layoutAccessibilityWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#120d00"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠  ACCESSIBILITY REQUIRED"
            android:textStyle="bold"
            android:textColor="#f0b429"
            android:letterSpacing="0.1"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Without it the volume buttons won't control your slides."
            android:textColor="#c48a00"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEnableAccessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Accessibility"
            android:backgroundTint="#f0b429"
            android:textColor="#0a0d1f"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>